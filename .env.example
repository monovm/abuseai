APP_NAME="Abuse AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads at rest. With SESSION_DRIVER=database this
# prevents anyone with read access to the sessions table from lifting
# auth tokens or session-bound CSRF tokens.
SESSION_ENCRYPT=true
# Refuse to send the session cookie over plain HTTP. Required in
# production. Flip to false ONLY for local dev over http://localhost.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
# Leave SESSION_DOMAIN=null when serving multiple brand hostnames
# (abuse.brand-a.com, abuse.brand-b.com, …) on a single app — Laravel
# will scope the session cookie to whatever host the request arrived
# on, so CSRF works on every brand. Pinning a single domain here
# breaks form posts on the other brands with a 419.
SESSION_DOMAIN=null

# Trusted proxies for X-Forwarded-* headers. Leave unset to use the
# bundled Cloudflare IP list (config/cloudflare.php). Set to a CSV of
# IPs/CIDRs to override, or "*" for dev/local-only when terminating
# TLS at a non-CF proxy. Required so request()->ip() returns the real
# visitor and request()->isSecure() sees CF's https → origin hop.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Virtualizor (IP → VPS lookup)
VIRTUALIZOR_URL=https://panel.yourdomain.com:4085
VIRTUALIZOR_API_KEY=
VIRTUALIZOR_API_PASS=

# WHMCS (Client → Service lookup)
WHMCS_API_URL=https://billing.yourdomain.com/includes/api.php
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=

VITE_APP_NAME="${APP_NAME}"

# POP3 Email Ingestion
POP3_HOST=
POP3_PORT=995
POP3_USERNAME=
POP3_PASSWORD=
POP3_SSL=true

# Mandrill (email sending via Mailchimp Transactional)
MANDRILL_KEY=

# AbuseIPDB
ABUSEIPDB_KEY=

# Webhook signing secrets. Each per-provider secret is required — the
# /api/v1/webhook/{provider} endpoint rejects unsigned/missing-secret
# requests rather than failing open. Set whichever providers you actually
# use; leave the rest unset and traffic to those endpoints will 403.
WEBHOOK_SECRET_ABUSEIPDB=
WEBHOOK_SECRET_SPAMHAUS=
WEBHOOK_SECRET_GOOGLE_FBL=
WEBHOOK_SECRET_MICROSOFT_FBL=
WEBHOOK_SECRET_SPAMCOP=

# Shared secret for the /api/v1/inbound-email MTA-pipe endpoint. The
# sending side passes it in X-Inbound-Secret. Empty disables the
# endpoint (503), which is the right default if you're not piping mail.
WEBHOOK_INBOUND_EMAIL_SECRET=

# Threat Intelligence
VIRUSTOTAL_KEY=
SHODAN_KEY=
SNDS_KEY=                    # Microsoft SNDS automated data key (register at sendersupport.olc.protection.outlook.com/snds/)

# AI Provider: 'claude' or 'openai'
AI_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
