# =====================================================================
# Abuse AI — Docker environment.
#   cp .env.docker.example .env  &&  docker compose up -d
# This file is read by both the containers and Docker Compose itself.
#
# NOTE ON COMMENTED-OUT SETTINGS
# Anything commented out below already has a working default in config/.
# Leaving a key present but empty (FOO=) sets it to an empty string and
# OVERRIDES that default — it does not fall back to it. Uncomment a line
# only when you are setting a real value.
# =====================================================================

APP_NAME="Abuse AI"
APP_ENV=production
# Leave APP_KEY blank — the container generates and persists one on first
# boot. For a fixed key run: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Host port the web UI is published on (container always listens on 80).
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Comma-separated old keys, kept so sessions/encrypted columns still decrypt
# after you rotate APP_KEY. Rotate: set the new key, move the old one here.
# APP_PREVIOUS_KEYS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
# LOG_DAILY_DAYS=14
# LOG_SLACK_WEBHOOK_URL=

# --- Container behaviour ---------------------------------------------
# AUTO_MIGRATE runs migrations on boot; AUTO_SEED loads demo data.
AUTO_MIGRATE=true
AUTO_SEED=false

# --- Database ---------------------------------------------------------
# Defaults target the bundled Postgres service. To use a managed database
# (RDS, Neon, Supabase, Cloud SQL) either fill in the fields below or set
# DB_URL and leave them alone.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=abuseai
DB_USERNAME=abuseai
DB_PASSWORD=change-me-please

# Single connection string; overrides the DB_HOST/PORT/... set above.
#   postgres://user:pass@host:5432/dbname?sslmode=require
# DB_URL=

# Most managed Postgres providers REFUSE plaintext connections. If the
# container cannot reach a hosted database, set this first.
#   disable | allow | prefer | require | verify-ca | verify-full
# DB_SSLMODE=require

# --- Redis / queues / cache -------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Single connection string; overrides REDIS_HOST/PORT above.
#   redis://user:pass@host:6379/0   (rediss:// for TLS)
# REDIS_URL=

# Hosted Redis/Valkey (Heroku Key-Value Store, DigitalOcean managed Valkey)
# serves rediss:// with a certificate this image cannot chain to, so phpredis
# refuses the handshake. Set this to relax the peer check only — traffic stays
# encrypted. Leave it off for any endpoint with a verifiable certificate.
# REDIS_TLS_INSECURE=true

# Managed Redis with ACLs (Redis 6+) needs a username as well as a password.
# REDIS_USERNAME=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# Set these when sharing one Redis instance with other applications, so the
# keyspaces cannot collide.
# REDIS_PREFIX=
# CACHE_PREFIX=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Local HTTP needs this false. Set to true once you serve over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
# lax | strict | none  — use "none" only together with SESSION_SECURE_COOKIE=true.
# SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Where failed queue jobs are recorded: database-uuids | database | dynamodb | null
# QUEUE_FAILED_DRIVER=database-uuids

# Path the Horizon dashboard is served under.
# HORIZON_PATH=horizon

# --- Reverse proxy / TLS ----------------------------------------------
# Set to "*" when running behind your own proxy (nginx, Traefik, a load
# balancer), or a CSV of trusted proxy IPs/CIDRs. Leave unset behind
# Cloudflare — the published CF ranges are trusted by default.
# Getting this wrong means every abuse report is logged with the proxy's IP
# instead of the reporter's.
# TRUSTED_PROXIES=*

# --- Mail delivery ----------------------------------------------------
# "log" writes outbound mail to the log instead of sending it — safe for a
# first boot, but the abuse desk cannot notify reporters or customers until
# you switch this to a real transport.
#   log | smtp | sendmail | postmark | resend | ses | array
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP — required when MAIL_MAILER=smtp.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# tls | ssl — leave unset to negotiate automatically (STARTTLS on 587).
# MAIL_SCHEME=tls
# Override the HELO/EHLO hostname if your relay checks it.
# MAIL_EHLO_DOMAIN=

# API transports — required when MAIL_MAILER is postmark / resend.
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=

# --- Email ingestion --------------------------------------------------
# POP3 mailbox the scheduler polls for inbound abuse reports.
POP3_HOST=
POP3_PORT=995
POP3_USERNAME=
POP3_PASSWORD=
POP3_SSL=true
MANDRILL_KEY=

# --- Public report form ----------------------------------------------
# reCAPTCHA gates the public abuse-report and partner forms. Leave both
# blank to run the forms without a captcha (fine on an internal host,
# not recommended on a public one).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- AI provider: 'claude' or 'openai' -------------------------------
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Point at an OpenAI/Anthropic-compatible gateway (LiteLLM, Azure OpenAI,
# a local model server) instead of the vendor endpoint.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com

# --- Threat intelligence ---------------------------------------------
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=
SHODAN_KEY=
SNDS_KEY=

# Enrichment toggles — both default to enabled.
# ABUSEIPDB_ENABLED=true
# DNSBL_ENABLED=true

# --- Webhook signing secrets -----------------------------------------
WEBHOOK_SECRET_ABUSEIPDB=
WEBHOOK_SECRET_SPAMHAUS=
WEBHOOK_SECRET_GOOGLE_FBL=
WEBHOOK_SECRET_MICROSOFT_FBL=
WEBHOOK_SECRET_SPAMCOP=
WEBHOOK_INBOUND_EMAIL_SECRET=

# --- Law enforcement / CSAM handling ----------------------------------
# CSAM reports are routed to this address. NCMEC_KEY enables CyberTipline
# submission. LAW_ENFORCEMENT_DOMAINS is a CSV of sender domains treated as
# law-enforcement requests (e.g. police.uk,fbi.gov).
CSAM_LE_EMAIL=
NCMEC_KEY=
LAW_ENFORCEMENT_DOMAINS=

# --- Infrastructure integrations (optional) --------------------------
VIRTUALIZOR_URL=
VIRTUALIZOR_API_KEY=
VIRTUALIZOR_API_PASS=
WHMCS_API_URL=
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
# Ticket department new WHMCS tickets are opened in.
WHMCS_TICKET_DEPARTMENT_ID=
# Admin username the WHMCS API acts as.
# WHMCS_ADMIN_USERNAME=

# --- Notifications (optional) ----------------------------------------
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# --- Object storage (optional, for evidence files) ------------------
# Set FILESYSTEM_DISK=s3 to store evidence off the container volume.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3-compatible storage (MinIO, Cloudflare R2, Wasabi, Backblaze B2):
# set AWS_ENDPOINT to the provider's API endpoint, and for MinIO also set
# AWS_USE_PATH_STYLE_ENDPOINT=true above.
# AWS_ENDPOINT=
# Public base URL for generated file links, if it differs from the endpoint.
# AWS_URL=
